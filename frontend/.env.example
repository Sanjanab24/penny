# Copy to .env.local. Values from Clerk Dashboard -> API Keys.
# Both Clerk keys are required; the app errors with "Clerk keys are missing" without them.
# No Clerk app yet? `npx clerk@latest init` writes temporary dev keys. Either way, set the backend's
# CLERK_ISSUER to the same instance's Frontend API URL.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# FastAPI backend base URL (no trailing slash, no /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ISO 4217 code used to display amounts, e.g. INR, USD, EUR. Defaults to INR.
NEXT_PUBLIC_CURRENCY=INR
# BCP 47 locale for number/date formatting. Defaults to en-IN (₹1,23,456.00).
NEXT_PUBLIC_LOCALE=en-IN
