# --- Database ---------------------------------------------------------------
# SQLAlchemy URL using the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/expense_tracker
# Optional: separate DB for pytest. Falls back to an in-memory SQLite DB if unset.
TEST_DATABASE_URL=

# --- Clerk auth -------------------------------------------------------------
# Clerk Dashboard -> API Keys -> "Frontend API URL", e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Defaults to {CLERK_ISSUER}/.well-known/jwks.json when empty.
CLERK_JWKS_URL=
# Comma-separated origins allowed in the token's `azp` claim (empty = skip check).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# --- Anthropic (used from Phase 6) -------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- App --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
